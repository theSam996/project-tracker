generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id          String          @id @default(cuid())
  email       String          @unique
  name        String?
  password    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  projects      Project[]
  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  createdTasks  Task[]          @relation("TaskCreator")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  key         String
  description String?
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime?
  targetDate  DateTime?
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]

  @@unique([userId, key])
  @@index([userId])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id          String        @id @default(cuid())
  taskNumber  Int
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?
  order       Int           @default(0)
  projectId   String
  userId      String?
  creatorId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("TaskAssignee", fields: [userId], references: [id], onDelete: SetNull)
  creator     User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@unique([projectId, taskNumber])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([userId])
  @@index([creatorId])
  @@index([dueDate])
  @@index([projectId, status, order])
}
